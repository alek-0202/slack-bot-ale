# Slack
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_APP_TOKEN=xapp-your-app-token

# Discord
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_GUILD_ID=your-discord-guild-id-optional

# Supabase/Postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Integrations
GIPHY_API_KEY=your-giphy-api-key
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3

# Healthcheck (optional local override)
HEALTHCHECK_PORT=3000
RENDERED_IMAGE_PUBLIC_BASE_URL=
# Legacy fallback only (used when RENDERED_IMAGE_PUBLIC_BASE_URL is empty)
PUBLIC_BASE_URL=

# Logging / alerting (optional)
LOG_LEVEL=info
LOG_FORMAT=text
CRITICAL_ALERT_WEBHOOK_URL=

# Elemental/characteristic skills feature flags
# Master hard-enablement for any env:
ENABLE_ELEMENTAL_SKILLS=false
# In development/local envs (APP_ENV/NODE_ENV = development|dev|local), allow by default:
ENABLE_ELEMENTAL_SKILLS_IN_DEV=true
# Optional granular overrides (if empty, inherit from effective default above):
ENABLE_ELEMENTAL_SKILLS_REGISTRY=
ENABLE_ELEMENTAL_SKILLS_MRSKILL=
ENABLE_ELEMENTAL_SKILLS_BATTLE=
